APP_ENV=xx

QDRANT_URL="xx"
QDRANT_API_KEY="xx"

QDRANT_COLLECTION_DEV="xx"
QDRANT_COLLECTION_PROD="xx"

GROQ_API_KEY="xx"

# OpenRouter — dipakai gatekeeper (klasifikasi Tim1 teks & Tim3 visual)
OPENROUTER_API_KEY="xx"
# Model gatekeeper (opsional). Default memakai model :free OpenRouter yang
# rate limit-nya ketat (8 rpm + kuota harian). Untuk produksi, set ke model
# berbayar/ber-key agar klasifikasi batch tidak kena 429, mis.:
#   GATEKEEPER_TEXT_MODEL=qwen/qwen3-next-80b-a3b-instruct
#   GATEKEEPER_VISUAL_MODEL=google/gemini-2.0-flash-001
GATEKEEPER_TEXT_MODEL=
GATEKEEPER_VISUAL_MODEL=

# Tim 3 — endpoint model visual (vLLM OpenAI-compatible). Semua klasifikasi
# visual (checker, upload, gatekeeper) ditembak ke sini, bukan ke OpenRouter.
VISUAL_API_BASE_URL=https://va4o83dml7dsfh-8001.proxy.runpod.net/v1
VISUAL_API_MODEL=pad3_model
VISUAL_API_KEY=EMPTY

# Apify — TikTok crawler + fallback Instagram (Playwright gagal -> Apify) + Twitter.
# APIFY_API_TOKEN = token universal, dipakai SEMUA crawler Apify (diutamakan).
APIFY_API_TOKEN=
APIFY_API_FREE=
APIFY_API_PREMIUM=

PAD_HOST=
PAD_PORT=
PAD_WORKERS_COUNT=
PAD_RELOAD=
PAD_LOG_LEVEL=
PAD_ENVIRONMENT=

PAD_POSTGRES_HOST=
PAD_POSTGRES_PORT=
PAD_POSTGRES_USER=
PAD_POSTGRES_PASS=
PAD_POSTGRES_DB=
PAD_POSTGRES_ECHO=
PAD_POSTGRES_ADMIN_USER=
PAD_POSTGRES_ADMIN_PASS=

