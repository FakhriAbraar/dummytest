# ============================================================================
# .env PRODUKSI — copy ke ~/aitf/.env di VPS lalu ISI semua nilai.
#   cp .env.prod.example .env && nano .env
# JANGAN commit file .env yang sudah terisi.
# ============================================================================

# ── Image (kosongkan = pakai default GHCR di docker-compose.prod.yml) ────────
# BACKEND_IMAGE=ghcr.io/aitf-komdigi-x-its-batch-2/aitf-backend
# FRONTEND_IMAGE=ghcr.io/aitf-komdigi-x-its-batch-2/aitf-frontend
BACKEND_TAG=prod
FRONTEND_TAG=prod

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
PAD_ENVIRONMENT=prod
PAD_HOST=0.0.0.0
PAD_PORT=8000
PAD_RELOAD=false
PAD_LOG_LEVEL=INFO
PAD_WORKERS_COUNT=1

# ── PostgreSQL (host = nama service compose) ─────────────────────────────────
PAD_POSTGRES_HOST=pad-postgres
PAD_POSTGRES_PORT=5432
PAD_POSTGRES_USER=pad
PAD_POSTGRES_PASS=GANTI_password_kuat
PAD_POSTGRES_DB=pad
PAD_POSTGRES_ECHO=false

# ── MongoDB ──────────────────────────────────────────────────────────────────
PAD_MONGO_HOST=pad-mongo
PAD_MONGO_PORT=27017
PAD_MONGO_USER=pad
PAD_MONGO_PASS=GANTI_password_kuat
PAD_MONGO_DB=pad

# ── MinIO (api 9000 internal, console 9001 dipublish) ────────────────────────
PAD_MINIO_HOST=pad-minio
PAD_MINIO_PORT=9000
PAD_MINIO_ACCESS_KEY=GANTI_access_key
PAD_MINIO_SECRET_KEY=GANTI_secret_key
PAD_MINIO_BUCKET=pad-bucket
PAD_MINIO_USE_SSL=false

# ── Qdrant CLOUD (RAG hukum, JANGAN pakai qdrant lokal) ──────────────────────
QDRANT_URL=https://xxxx.aws.cloud.qdrant.io
QDRANT_API_KEY=GANTI_qdrant_api_key
QDRANT_COLLECTION_DEV=pad_hukum_dev
QDRANT_COLLECTION_PROD=pad_hukum_prod

# Cache model embedding di dalam container (di-mount ke volume pad-hf-cache)
SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers

# ── OpenRouter (Tim1 text + Tim3 visual LLM). Kosong = fallback dummy ────────
OPENROUTER_API_KEY=GANTI_openrouter_key
# OPENROUTER_MODEL_TIM1=meta-llama/llama-3.1-70b-instruct
# OPENROUTER_MODEL_TIM3=google/gemma-3-4b-it

# ── Crawler: Apify (TikTok / IG / X) ─────────────────────────────────────────
APIFY_API_FREE=GANTI_apify_free
APIFY_API_PREMIUM=GANTI_apify_premium

# ── Crawler: Instagram / Twitter (opsional, kalau pakai login langsung) ──────
IG_USER=
IG_PASS=
TW_USER=
TW_PASS=
